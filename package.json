{
  "name": "dsh-mini-games-lee",
  "version": "0.2.0",
  "description": "Mini-games collection for the DeepSeek Harness Web GUI — one draggable frosted-glass window with Tetris, Snake, 2048 and Minesweeper, light/dark themes and per-game local leaderboards. · DeepSeek Harness Web 端小游戏合集：俄罗斯方块 / 贪吃蛇 / 2048 / 扫雷，毛玻璃悬浮窗、深浅色主题、各游戏独立排行榜。",
  "type": "module",
  "main": "dist/cordis-plugin.js",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "client",
    "ui",
    "mini-games",
    "tetris",
    "snake",
    "2048",
    "minesweeper",
    "cordis_define"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeGuanWei-a/dsh-mini-games-lee.git"
  },
  "homepage": "https://github.com/LeeGuanWei-a/dsh-mini-games-lee#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./dist/cordis-plugin.js"
    },
    "./client": {
      "default": "./dist/cordis-plugin.code.txt"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis-plugin.code.txt",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-lib.mjs",
    "build:cordis": "node scripts/build-cordis.mjs",
    "dev:cordis": "node scripts/dev-cordis.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:cordis": "node scripts/smoke-cordis.mjs",
    "render-check": "node scripts/render-check.mjs",
    "check": "npm run build:cordis && npm run smoke:cordis && npm run smoke && npm run render-check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "happy-dom": "^15.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
