{
  "name": "dsh-mini-games-lee",
  "version": "0.5.0",
  "description": "Mini-games collection for the DeepSeek Harness Web GUI (dsh 0.2.x) — one draggable frosted-glass window with Tetris, Snake, 2048 and Minesweeper, light/dark themes and per-game local leaderboards. · DeepSeek Harness Web 端小游戏合集：俄罗斯方块 / 贪吃蛇 / 2048 / 扫雷，毛玻璃悬浮窗、深浅色主题、各游戏独立排行榜。",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "client",
    "ui",
    "mini-games",
    "tetris",
    "snake",
    "2048",
    "minesweeper"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeGuanWei-a/dsh-mini-games-lee.git"
  },
  "homepage": "https://github.com/LeeGuanWei-a/dsh-mini-games-lee#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-cordis.mjs",
    "dev": "node scripts/dev-cordis.mjs",
    "smoke": "node scripts/smoke.mjs",
    "render-check": "node scripts/render-check.mjs",
    "check:host": "node scripts/check-host-contract.mjs",
    "check": "npm run build && npm run smoke && npm run render-check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "happy-dom": "^15.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
